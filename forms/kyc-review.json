{
  "title": "KYC compliance review",
  "name": "kycReview",
  "path": "kyc-review",
  "type": "form",
  "display": "form",
  "properties": { "processKey": "kyc-onboarding", "owner": "compliance" },
  "components": [
    { "type": "radio", "key": "approved", "label": "Decision", "input": true, "validate": { "required": true },
      "values": [ { "label": "Approve", "value": true }, { "label": "Reject", "value": false } ] },
    { "type": "textarea", "key": "reviewNotes", "label": "Notes", "input": true, "validate": { "required": true } },
    { "type": "button", "key": "submit", "label": "Submit", "action": "submit" }
  ]
}
