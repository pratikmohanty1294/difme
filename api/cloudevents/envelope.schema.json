{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://difme.local/schemas/cloudevent-envelope.json",
  "title": "DIFME CloudEvents 1.0 envelope (PDF §5.10)",
  "type": "object",
  "required": ["specversion", "id", "source", "type", "time", "traceparent", "eventtimestamp"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "source": { "type": "string", "format": "uri-reference" },
    "type": { "type": "string", "pattern": "^dev\\.difme\\.[a-z]+\\.[A-Za-z]+\\.v[0-9]+$" },
    "time": { "type": "string", "format": "date-time" },
    "traceparent": { "type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$" },
    "eventtimestamp": { "type": "string", "format": "date-time", "description": "Official 'now' for deterministic replay" },
    "datacontenttype": { "type": "string" },
    "dataschema": { "type": "string", "format": "uri" }
  }
}
