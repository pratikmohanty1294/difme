{
  "name": "@difme/discountai-pwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DiscountAI role apps (ShopBot buyer, Buying Partner investor, Exchange OME) as installable PWAs, ported from the prototype (ADR-020).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:shopbot": "vite build --mode shopbot",
    "build:investor": "vite build --mode investor",
    "build:exchange": "vite build --mode exchange",
    "build:all": "npm run build && npm run build:shopbot && npm run build:investor && npm run build:exchange"
  },
  "dependencies": {
    "feelin": "^8.2.0",
    "jose": "^6.2.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "~5.6.3",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.2"
  }
}
