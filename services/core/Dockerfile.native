# Native-image runtime (ADR-012) for the light services: ~25-50 MB RSS, ~50 ms startup.
# The binary is built by Mandrel (GPLv2+CE) in the image pipeline's prebuild step.
FROM debian:bookworm-slim
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends zlib1g ca-certificates \
 && rm -rf /var/lib/apt/lists/* && useradd -u 1001 -r app
ARG MODULE
WORKDIR /app
COPY --chown=1001 services/core/${MODULE}/target/*-runner /app/application
USER 1001
# Same thread/native-memory limits as Dockerfile.jvm (Netty arenas, event loops, malloc arenas).
ENV MALLOC_ARENA_MAX=2 QUARKUS_VERTX_EVENT_LOOPS_POOL_SIZE=2
ENTRYPOINT ["/app/application", "-Dquarkus.http.host=0.0.0.0", "-Xmx64m", "-Dio.netty.allocator.numDirectArenas=2", "-Dio.netty.allocator.numHeapArenas=2", "-Dio.netty.allocator.maxOrder=7"]
