# Generic runtime image for every Quarkus module (fast-jar layout). Built by .github/workflows/_image.yml.
FROM eclipse-temurin:25-jre AS fdb
ARG FDB_VERSION=7.3.63
ADD https://github.com/apple/foundationdb/releases/download/${FDB_VERSION}/foundationdb-clients_${FDB_VERSION}-1_amd64.deb /tmp/fdb-clients.deb

FROM eclipse-temurin:25-jre
ARG MODULE
ARG WITH_FDB=false
# FoundationDB native client only where the module uses it (cmd-svc idempotency store).
RUN --mount=type=bind,from=fdb,source=/tmp,target=/fdb \
    if [ "$WITH_FDB" = "true" ]; then dpkg -i /fdb/fdb-clients.deb && rm -rf /var/lib/apt/lists/*; fi
WORKDIR /deployments
# Whole fast-jar layout, including the AOT cache (app.aot) when the build generated one.
COPY --chown=185 services/core/${MODULE}/target/quarkus-app/ ./
USER 185
# ADR-012: compact object headers, small thread stacks, bounded code cache, low-pause G1, Java 25 AOT cache if present.
ENV JAVA_OPTS_APPEND="-XX:+UseCompactObjectHeaders -XX:MaxRAMPercentage=70 -XX:+UseG1GC -XX:MaxGCPauseMillis=20 -Xss512k -XX:ReservedCodeCacheSize=64m -XX:+ExitOnOutOfMemoryError" \
    QUARKUS_HTTP_HOST=0.0.0.0
ENTRYPOINT ["sh", "-c", "AOT=; for f in /deployments/*.aot; do [ -f \"$f\" ] && AOT=-XX:AOTCache=$f; done; exec java $JAVA_OPTS_APPEND $AOT -jar /deployments/quarkus-run.jar"]
